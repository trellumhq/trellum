# trellum configuration. Copy to .env and fill in.
#
#   cp .env.example .env
#
# Everything tenant-level (SSO, LLM keys, repo tokens, datasource credentials)
# is configured in the UI and stored encrypted in the database. Only
# instance-level settings belong here.

# ── Required ────────────────────────────────────────────────────────────────

# Signs session cookies and the one-time links in invitation and
# password-reset email.
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SESSION_SECRET_KEY=

# python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Encrypts every tenant secret at rest. LOSING THIS MEANS LOSING THEM ALL:
# back it up somewhere other than this host. Rotate with `manage.py
# rotate_encryption` by listing the new key first: NEW,OLD
SECRET_ENCRYPTION_KEY=

# Password for the bundled Postgres container. Ignored when DATABASE_URL is set.
POSTGRES_PASSWORD=

# The public URL. Used for invite links, SSO redirect URIs and webhook URLs.
PORTAL_BASE_URL=https://bi.example.com
ALLOWED_HOSTS=bi.example.com

# ── Image ───────────────────────────────────────────────────────────────────

# Pin the version you tested. `latest` makes an upgrade something that happens
# to you rather than something you decide.
# TRELLUM_IMAGE=ghcr.io/your-org/trellum:v1.2.3

# Source provenance for fork or custom builds. Official release images bake an
# exact commit URL automatically. SOURCE_URL is the Docker build argument;
# TRELLUM_SOURCE_URL is the direct-process runtime override. Use an exact,
# public http(s) source-tree URL with no credentials.
# SOURCE_URL=https://github.com/your-org/trellum/tree/<commit>
# TRELLUM_SOURCE_URL=https://github.com/your-org/trellum/tree/<commit>

# ── Database ────────────────────────────────────────────────────────────────

# The bundled `db` container is for evaluation: no replication, no PITR, no
# managed backups. For production point this at a database you own and start
# with the external-db overlay:
#   docker compose -f docker-compose.yml -f docker-compose.external-db.yml up -d
# (see https://trellum.dev/docs/latest/install/configuration/)
# DATABASE_URL=postgres://user:pass@db.internal:5432/trellum_portal

# ── Host-folder data storage (optional, Linux) ────────────────────────────────
# Docker 25 needs this override; the default named volume needs Docker 26+.
# Prepare/migrate the directory first; see the Docker Compose install guide.
# COMPOSE_FILE=docker-compose.yml:docker-compose.bind-data.yml
# TRELLUM_DATA_HOST_PATH=/srv/trellum/data
# Leave TRELLUM_DATA_VOLUME unset with this storage mode.

# ── Operational policy ──────────────────────────────────────────────────────

# Product features are available in every installation. These switches set
# deployment policy; the defaults are shown here.
# TRELLUM_ORG_SELF_SIGNUP=false
# TRELLUM_QUOTAS_ENABLED=false
# TRELLUM_IMPERSONATION_ENABLED=true
# TRELLUM_SSO_DOMAIN_VERIFICATION=true

# ── Report builds ───────────────────────────────────────────────────────────

# How many builds one runner hosts at once.
WORKER_MAX_CONCURRENT=3

# Total memory the runner will commit to builds, in MB. Size it as:
#   total_ram_mb - 1024 (postgres) - 1024 (web) - 512 (headroom)
# On an 8 GB VM that is roughly 5600. Left at 0, only WORKER_MAX_CONCURRENT
# limits concurrency and there is no memory accounting.
TRELLUM_RUNNER_MEMORY_BUDGET_MB=0

# Memory allocated to every build. The runner reserves this amount for
# admission and derives the process/container hard limit from it. Report
# manifests cannot override operator memory policy.
TRELLUM_DEFAULT_JOB_MEMORY_MB=1024

# Which half of the worker this process runs: all | coordinator | runner.
# Leave as "all" unless you are running the split topology.
# TRELLUM_RUNNER_ROLE=all

# Studio pools accepted by this runner: empty = all pools. Set this per runner
# service when routing studios to dedicated machines (small, standard, large).
# Pool names route jobs; they do not set the runner's memory or CPU limits.
# TRELLUM_RUNNER_POOLS=small,standard

# ── Report sandboxing ───────────────────────────────────────────────────────
# Report code is arbitrary tenant Python. In production each build runs in a
# throwaway Docker container (non-root, read-only, resource-limited, no portal
# secrets, network-segregated). Declared data-source credentials are injected
# for the report to use. The worker needs the Docker socket for this;
# DOCKER_GID gives its uid 10001 access to the root:docker socket.
#
# REQUIRED for the worker/runner services. Find it with:
#   getent group docker | cut -d: -f3
DOCKER_GID=

# The sandbox runner image (built by the sandbox-image compose service).
# TRELLUM_RUNNER_IMAGE=trellum-runner:dev

# Isolation mode: "docker" (production; the worker fails closed at boot if it
# can't reach the daemon) or "off" (DEV ONLY — runs tenant code unsandboxed in
# the worker container). Anything else is refused rather than assumed.
# TRELLUM_SANDBOX=docker

# Whether report code can reach the internet. "deny" (default) puts sandboxes on
# an internal Docker network: they see the data sources materialized for them
# and nothing else. Decrypted warehouse credentials are injected into these
# containers, so open egress is also the path by which they leave.
#
# Reports that connect to remote warehouses or APIs need outbound network
# access. Set "open" only when that access is intended; `doctor` reports it.
# If you change this on an existing install, drain/stop all worker and runner
# services on that host, then remove trellum-sandbox so it is recreated on start.
# TRELLUM_SANDBOX_EGRESS=deny

# After first start, run once per host to block cloud metadata / host services
# from sandboxes (MANDATORY on cloud VMs):  sudo docker/harden-sandbox-net.sh

# ── Optional ────────────────────────────────────────────────────────────────

# SMTP for invitations and password resets. Without it, mail goes to the
# container log and invites still show a copyable link.
# Optional here: the first-run wizard and System -> Instance settings configure
# SMTP in the portal, and that takes precedence over this. Set it here only if
# you would rather mail config lived with the rest of your deployment config.
# EMAIL_URL=smtp://user:pass@smtp.example.com:587/?tls=True

# Bind address and port for the web container.
# TRELLUM_BIND_ADDRESS=127.0.0.1
# TRELLUM_PORT=8050

# ── Backups ─────────────────────────────────────────────────────────────────
# The backup service runs by default. The bundled database has no replication
# and no point-in-time recovery, so these dumps are your whole recovery story.

# Where to copy backups so they survive losing this host. An rsync/ssh target.
# Without it, your backups die with the machine they are protecting.
# BACKUP_REMOTE_TARGET=backups@nas.internal:/trellum-portal

# BACKUP_KEEP_DAYS=14
# BACKUP_INTERVAL_SECONDS=86400

# How stale the newest verified backup may get before `doctor` and /system go
# red. 36h gives a nightly backup one missed run of slack.
# BACKUP_MAX_AGE_HOURS=36

# ── Retention ───────────────────────────────────────────────────────────────
# Run history, audit rows, assistant transcripts and sessions have no natural
# ceiling; on one VM the disk is what fills. Cleanup runs nightly on the
# coordinator. Age windows use days unless named HOURS; 0 disables the
# corresponding age-based purge. KEEP_PER_REPORT is a count, not an age.
#
# Preview what a run would remove, changing nothing:
#   docker compose exec web python manage.py cleanup --dry-run

# CLEANUP_ENABLED=true
# CLEANUP_CRON=17 3 * * *

# Terminal runs older than this. Active runs are never touched at any age, and
# runs inside the current calendar month (UTC) are never removed — monthly build
# minutes are derived from them.
# RETENTION_RUN_DAYS=90
# ...but always keep the newest N per report, so a quarterly report does not
# lose its whole history to the window above.
# RETENTION_RUN_KEEP_PER_REPORT=10
# Blank the stdout/stderr tails of older runs while keeping the rows. The tails
# are most of the bytes; the row is what history and quotas need.
# RETENTION_RUN_OUTPUT_DAYS=14

# RETENTION_AUDIT_DAYS=365
# RETENTION_ASSISTANT_SESSION_DAYS=180   (LLM spend records are never purged)
# RETENTION_INVITATION_DAYS=30       (accepted or expired only)
# RETENTION_TMP_RUN_HOURS=48         (sandbox scratch dirs)

# ── Release check ───────────────────────────────────────────────────────────
# Off by default: the portal makes no outbound call unless you ask it to. Set
# it to true and the coordinator asks the public releases feed on GitHub once a
# day, and /system lists the latest releases. A feed it cannot reach changes
# nothing and logs nothing.
# TRELLUM_UPDATE_CHECK=false

# ── Logging ─────────────────────────────────────────────────────────────────
# "text" (default) reads well in `docker compose logs`. Use "json" when you ship
# logs somewhere that parses them — every line then carries the request id, so
# one report build can be followed across web, worker and sandbox.
# LOG_FORMAT=text
# LOG_LEVEL=INFO

# How many reverse proxies you operate in front of this instance. 0 (default)
# means audit rows record the connection address; X-Forwarded-For is
# client-supplied, so trusting it without this would let anyone write any
# address into the audit trail. Set 1 for the documented single nginx/Caddy.
# TRELLUM_TRUSTED_PROXIES=1

# ── Security ────────────────────────────────────────────────────────────────
# Most of this is derived from PORTAL_BASE_URL and needs no attention. Listed
# because the defaults are decisions, not accidents.

# HSTS is one year when PORTAL_BASE_URL is https, off otherwise — sending it
# from a host that must keep serving HTTP locks that host out of browsers.
# Subdomains and preload stay opt-in: this host may share a parent domain with
# hosts you have not hardened, and preload is close to irreversible.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false

# Redirecting to HTTPS is your proxy's job in the documented deployment.
# SECURE_SSL_REDIRECT=false

# Cookies follow PORTAL_BASE_URL's scheme. Override if TLS terminates in front
# in a way the base URL does not describe.
# SESSION_COOKIE_SECURE=true

# Idle session lifetime, refreshed on activity. Django's default is two weeks,
# which is a long time for a console that reaches every organization.
# SESSION_COOKIE_AGE=43200

# Failed logins tolerated per email AND per client address before further
# attempts are ignored for the window. 0 disables it.
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_ATTEMPT_WINDOW_SECONDS=900

# The CSP applies to the management surface only; built report pages are
# tenant-authored and exempt. Report-only until you have watched your own
# console for violations.
# CSP_REPORT_ONLY=true
